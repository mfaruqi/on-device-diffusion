# Secrets
.env
*.token
.huggingface/
hf_token*

# Model weights and caches (live on cluster storage, see notes)
*.safetensors
*.ckpt
*.bin
*.gguf
huggingface/

# Environments
.venv/
venv/
env/
__pycache__/
*.pyc

# Large or generated outputs
logs/
results/runs/*/images/
results/runs/*/profile/trace.json
*.pt.trace.json
flux_test/*.json
flux_test/*.png

# Editor
*.swp
*.swo
.vscode/
.DS_Store

# Agent files (CLAUDE.md, AGENTS.md, .claude/, .agents/, .codex/) are tracked; only personal
# Claude Code permission settings stay local.
.claude/settings.local.json
results/runs/*/engine/raw/
results/runs/*/profile/*.nsys-rep
results/runs/*/profile/*.sqlite

# Obsidian: personal settings stay local; the shared vault settings are committed
.obsidian/*
!.obsidian/app.json


# CLI feasibility images remain local
results/runs/*/*.png

# Raw CLI and monitoring logs remain local
results/runs/*/*.log

# Imported profiling originals remain local
results/runs/**/*.nsys-rep
results/runs/**/*.qdstrm
results/runs/**/*.sqlite
results/runs/**/*.log
results/runs/**/*.png

# Harness RGB outputs, including imported originals
results/runs/**/*.rgb
